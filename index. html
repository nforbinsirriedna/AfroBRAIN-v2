<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AfroBRAIN v2</title><style>body{margin:0;background:#0a0820;color:#fff;font-family:Inter,Arial;overflow:hidden}#p{max-width:420px;margin:0 auto;height:100vh;position:relative;background:radial-gradient(600px 400px at 50% -10%,#2a1a6a 0%,#0a0820 70%);}.screen{position:absolute;inset:0;padding:14px;overflow-y:auto;display:none}.screen.active{display:block}.card{background:linear-gradient(180deg,#1e1744 0%,#15112f 100%);border:1px solid #3d2f7a;border-radius:24px;padding:18px;box-shadow:0 0 30px rgba(180,122,255,.35),inset 0 1px 0 rgba(255,255,255,.1)}h1{color:#fbe67e;margin:6px 0 0;font-size:28px;letter-spacing:.5px;text-shadow:0 0 12px rgba(251,230,126,.6)}h2{color:#fbe67e;margin:0;display:flex;align-items:center;gap:8px}.sub{color:#b47aff;font-size:13px;margin:2px 0 12px}.btn-pill{width:100%;background:linear-gradient(90deg,#4a2bbf 0%,#2d1b6e 100%);border:1px solid #8a5cff;border-radius:18px;padding:14px 16px;margin:10px 0;display:flex;justify-content:space-between;align-items:center;color:#fff;cursor:pointer;box-shadow:0 0 12px rgba(138,92,255,.4);text-align:left}.btn-pill b{color:#fff}.btn-pill span{font-size:11px;opacity:.7}.btn-pill:active{transform:scale(.98)}#ring{width:190px;height:190px;border:2px solid #3d2f7a;border-radius:50%;margin:18px auto;position:relative;display:flex;align-items:center;justify-content:center}#ring::before{content:'';position:absolute;inset:-4px;border-radius:50%;border:3px solid transparent;border-top-color:#fbe67e;border-right-color:#b47aff;transform:rotate(-20deg);box-shadow:0 0 20px #b47aff}#ring b{font-size:44px;color:#fbe67e;text-shadow:0 0 15px #fbe67e}.row{display:flex;gap:10px;margin-top:14px}.b-gold{flex:1;background:#fbe67e;color:#1a1633;border:none;border-radius:14px;padding:14px;font-weight:900;cursor:pointer}.b-out{flex:1;background:#1a1633;border:1px solid #fbe67e;color:#fbe67e;border-radius:14px;padding:14px;font-weight:800}.grid5{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:10px}.tile{height:52px;background:#221c4a;border:1px solid #3d2f7a;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;cursor:pointer}.tile.on{background:linear-gradient(180deg,#fbe67e,#c9a84a);color:#000;box-shadow:0 0 12px #fbe67e}canvas{width:100%;height:110px;background:#0d0b24;border:1px solid #2a245a;border-radius:12px;margin-top:10px}.stats{display:flex;gap:8px;margin-top:10px}.stat{flex:1;background:#1c1840;border-radius:10px;padding:8px;font-size:11px;text-align:left}.back{cursor:pointer;font-size:20px}.top{display:flex;justify-content:space-between;align-items:center}.live{color:#fbe67e;font-size:12px;letter-spacing:1px}.nav{position:absolute;bottom:0;left:0;right:0;background:#13102a;border-top:1px solid #2a245a;display:flex;justify-content:space-around;padding:10px 0;font-size:12px;color:#6b5aa8}.nav b{color:#fbe67e}</style></head><body><div id="p">
<div id="home" class="screen active"><div class="card"><div style="text-align:center"><div style="font-size:56px;filter:drop-shadow(0 0 12px #b47aff)">🧠</div><h1>AfroBRAIN</h1><div class="sub">Train Your Brain</div></div>
<button class="btn-pill" onclick="go('focus')"><div style="display:flex;gap:10px;align-items:center"><span style="font-size:22px">⏱️</span><b>Focus Timer</b></div><span>Stay focused with 25min sessions</span></button>
<button class="btn-pill" onclick="go('memory')"><div style="display:flex;gap:10px;align-items:center"><span style="font-size:22px">🧠</span><b>Memory Game</b></div><span>Match pairs to boost recall</span></button>
<button class="btn-pill" onclick="go('eeg')"><div style="display:flex;gap:10px;align-items:center"><span style="font-size:22px">〰️</span><b>EEG Simulator</b></div><span>Visualize live brain waves</span></button>
</div><div class="nav"><div><b>🏠</b></div><div>Stats</div><div>⚙️</div></div></div>

<div id="focus" class="screen"><div class="card"><div class="top"><div style="display:flex;gap:10px;align-items:center"><span class="back" onclick="go('home')">‹</span><h2>Focus Timer</h2></div><span style="color:#fbe67e">II</span></div>
<div id="ring"><b id="t">25:00</b></div><div class="sub" style="text-align:center">Focus Session • <span id="flen">25 Minutes</span></div>
<div class="row"><button class="b-out" id="pau" onclick="toggleF()">II PAUSE</button><button class="b-gold" onclick="stopF()">⚙ STOP</button></div><div class="sub" style="text-align:center;margin-top:10px">Stay still, stay focused — <span id="intr">0</span> interruptions</div></div></div>

<div id="memory" class="screen"><div class="card"><div class="top"><div style="display:flex;gap:8px;align-items:center"><span class="back" onclick="go('home')">‹</span><h2>Memory Game</h2></div><div style="color:#fbe67e;font-size:13px">Score: <b id="ms">340</b> ⭐</div></div><div class="sub">Match the star pairs • <span id="mp">6/12 pairs found</span></div><div class="grid5" id="mg"></div></div><div class="nav"><div onclick="go('home')"><b>🏠</b></div><div>Stats</div><div>⚙️</div></div></div>

<div id="eeg" class="screen"><div class="card"><div class="top"><div style="display:flex;gap:8px;align-items:center"><span class="back" onclick="go('home')">‹</span><h2>EEG Simulator</h2></div><div class="live">●●●● LIVE</div></div><div class="sub">Real-time EEG waveform • Alpha waves</div><canvas id="wave" width="360" height="110"></canvas><div class="stats"><div class="stat">〰️ Amplitude:<br><b id="am">42 µV</b></div><div class="stat">〰️ Frequency:<br><b id="fr">10.2 Hz</b></div><div class="stat">🧠 Status:<br><b id="st">Calm</b></div></div><div class="row"><button class="b-gold" style="width:100%" id="ebtn" onclick="toggleE()">PAUSE RECORDING</button></div></div></div>
</div>
<script>
function go(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');if(id=='memory')initM();}
let sec=1500,rem=1500,ti=null,paused=false,inter=0;function upd(){let m=Math.floor(rem/60),s=rem%60;document.getElementById('t').innerText=(m<10?'0':'')+m+':'+(s<10?'0':'')+s;}function toggleF(){if(!ti){ti=setInterval(()=>{if(paused)return;rem--;upd();if(rem<=0){clearInterval(ti);ti=null;rem=sec;upd();alert('Focus done!');}},1000);}else{paused=!paused;document.getElementById('pau').innerText=paused?'▶ RESUME':'II PAUSE';}}function stopF(){clearInterval(ti);ti=null;paused=false;rem=sec;upd();document.getElementById('pau').innerText='II PAUSE';inter++;document.getElementById('intr').innerText=inter;}
let ms=0,first=null,lock=false,found=0;function initM(){let g=document.getElementById('mg');g.innerHTML='';let icons=['⭐','⭐','⭐','☆','⭐','☆','','⭐','⭐','⭐','⭐','','','⭐','⭐','⭐','⭐','⭐','','','⭐','⭐'];let a=[];for(let i=0;i<20;i++)a.push(icons[i]||'');a=a.sort(()=>Math.random()-.5);found=0;ms=340;first=null;document.getElementById('ms').innerText=ms;g.innerHTML='';a.forEach(ic=>{let d=document.createElement('div');d.className='tile';d.innerText=ic||'';if(ic) {d.onclick=()=>{if(lock||d.classList.contains('on'))return;d.classList.add('on');if(!first){first=d;}else{if(first.innerText==d.innerText&&first!=d&&first.innerText!=''){first.classList.add('on');d.classList.add('on');ms+=20;found++;document.getElementById('ms').innerText=ms;document.getElementById('mp').innerText=found+'/12 pairs found';first=null;}else{lock=true;setTimeout(()=>{first.classList.remove('on');d.classList.remove('on');first=null;lock=false;},500);}}};} g.appendChild(d);});}
let eOn=true,ph=0,anim=null;let cv=document.getElementById('wave'),cx=cv.getContext('2d');function draw(){cx.clearRect(0,0,360,110);cx.strokeStyle='#fbe67e';cx.shadowColor='#b47aff';cx.shadowBlur=8;cx.lineWidth=2;cx.beginPath();for(let x=0;x<360;x++){let y=55+Math.sin((x+ph)/14)*22+Math.sin((x+ph*0.5)/6)*8+(Math.random()-.5)*2;if(x==0)cx.moveTo(x,y);else cx.lineTo(x,y);}cx.stroke();cx.shadowBlur=0;ph+=2.5;document.getElementById('am').innerText=(38+Math.random()*12).toFixed(0)+' µV';document.getElementById('fr').innerText=(9+Math.random()*3).toFixed(1)+' Hz';anim=requestAnimationFrame(draw);}function toggleE(){eOn=!eOn;document.getElementById('ebtn').innerText=eOn?'PAUSE RECORDING':'START RECORDING';if(eOn)draw();else cancelAnimationFrame(anim);}initM();draw();
</script></body></html>
