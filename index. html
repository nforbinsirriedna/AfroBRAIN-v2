<!DOCTYPE html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>AfroBRAIN v2 - Edna</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#0a0a1a;color:#fff;font-family:system-ui;padding:12px;background:linear-gradient(180deg,#0a0a1a,#1a0a2e)}
h1{font-size:28px;text-align:center;margin-top:20px}h1 span{color:#6ef7cc}
.sub{text-align:center;opacity:.7;margin-bottom:18px}
.card{background:rgba(255,255,255,0.06);border:1px solid rgba(110,247,204,.2);border-radius:18px;padding:14px;margin:12px 0;backdrop-filter:blur(10px)}
.btn{border:0;padding:10px 18px;border-radius:20px;font-weight:bold;margin:6px}
.green{background:#6ef7cc;color:#000}.purple{background:#a78bfa;color:#fff}.pink{background:#f472b6;color:#fff}
#wave{height:80px;background:#000;border-radius:12px;margin:10px 0;position:relative;overflow:hidden;border:1px solid #333}
#line{position:absolute;top:50%;width:100%;height:2px;background:linear-gradient(90deg,#6ef7cc,#a78bfa)}
.game{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0}
.tile{aspect-ratio:1;background:#1a1a3a;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:24px;border:1px solid #333}
.timer{font-size:42px;text-align:center;color:#6ef7cc;font-weight:bold}
</style></head>
<body>
<h1>AfroBRAIN <span>v2</span></h1><p class="sub">Edna Nforbin, 13, Bamenda - Train Your Brain</p>

<div class="card">
<div style="text-align:center;font-size:40px">🧠</div>
<p style="text-align:center;color:#a78bfa">Neuroscience for African Youth</p>
<div style="display:flex;flex-wrap:wrap;justify-content:center;margin-top:10px">
<button class="btn purple" onclick="show('focus')">Focus Timer</button>
<button class="btn green" onclick="show('memory')">Memory Game</button>
<button class="btn pink" onclick="show('eeg')">EEG Simulator</button>
</div>
<p id="waveText" style="text-align:center;margin-top:10px">Wave: Rest - 10Hz Alpha - Calm</p>
<div id="wave"><div id="line"></div></div>
<div style="text-align:center"><button class="btn green" onclick="mode='rest';run=true">Rest</button><button class="btn purple" onclick="mode='focus';run=true">Focus</button></div>
</div>

<div class="card" id="focusCard"><h3>Focus Timer</h3><div class="timer" id="timer">25:00</div><p style="text-align:center">Focus Session</p>
<div style="text-align:center"><button class="btn purple" onclick="startTimer(25)">25 min</button><button class="btn" style="background:#333;color:#fff" onclick="startTimer(10)">10 min</button><button class="btn" style="background:#333;color:#fff" onclick="startTimer(50)">50 min</button></div>
<div style="text-align:center;margin-top:8px"><button class="btn green" onclick="startTimer(25)">START</button><button class="btn" style="background:#444;color:#fff" onclick="pauseTimer()">Pause</button></div></div>

<div class="card"><h3 style="color:#f472b6">Memory Game</h3><p>Match the pairs - Score: <span id="score">0</span></p>
<div class="game" id="game"></div><div style="text-align:center"><button class="btn" style="background:#333;color:#fff" onclick="resetGame()">RESET GAME</button></div></div>

<div class="card"><h3 style="color:#6ef7cc">EEG Simulator</h3><p>Live brain wave - Educational</p><div id="wave2" style="height:60px;background:#000;border-radius:10px;margin:8px 0;border:1px solid #6ef7cc;display:flex;align-items:center;justify-content:center;color:#6ef7cc">~~~ Brain Wave Live ~~~</div>
<div style="text-align:center"><button class="btn pink" onclick="mode='rest';run=true">START SIMULATION</button><button class="btn" style="background:#333;color:#fff">RECORD</button></div><p style="font-size:11px;opacity:.6;margin-top:6px">Educational only - Not a medical device</p></div>

<script>
let mode='rest',run=true,timerInt,sec=1500;
function loop(){if(!run)return;let el=document.getElementById('line');let f=mode=='rest'?2:5;el.style.transform='translateY('+Math.sin(Date.now()/200*f)*20+'px)';requestAnimationFrame(loop)}loop();
function show(s){document.getElementById(s+'Card')?.scrollIntoView({behavior:'smooth'})}
function startTimer(m){sec=m*60;clearInterval(timerInt);timerInt=setInterval(()=>{sec--;let mm=Math.floor(sec/60);let ss=sec%60;document.getElementById('timer').innerText=(mm<10?'0':'')+mm+':'+(ss<10?'0':'')+ss;if(sec<=0)clearInterval(timerInt)},1000)}
function pauseTimer(){clearInterval(timerInt)}
let icons=['⭐','🧠','💜','🔬','🌍','🎯'];let tiles=[];
function resetGame(){let g=document.getElementById('game');g.innerHTML='';tiles=[...icons,...icons].sort(()=>Math.random()-0.5);tiles.forEach((ic,i)=>{let d=document.createElement('div');d.className='tile';d.innerText='?';d.onclick=()=>{d.innerText=ic;d.style.background='#a78bfa';};g.appendChild(d)});document.getElementById('score').innerText='0'}resetGame();
</script>
</body></html>
